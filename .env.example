POSTGRES_PASSWORD=stackplan-local
FRONTEND_PORT=5173
DOCUMENT_DIRECTORY=/data/documents
# Existing Project 2 variable names remain supported.
OPENAI_API_KEY=
OPENAI_MODEL=
# These names can override the corresponding OPENAI settings.
GPT_API_KEY=
GPT_MODEL=
GPT_BASE_URL=https://api.openai.com/v1
DOCLING_URL=http://docling:5001
DOCLING_IMAGE=quay.io/docling-project/docling-serve-cpu:v1.21.0

# Bounded document pipeline; Docling stays at one conversion.
GPT_CONCURRENCY=2
DOCUMENT_WORKERS=3
