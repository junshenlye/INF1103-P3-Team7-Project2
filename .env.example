# Copy to .env and replace local placeholders before starting the application.
# .env is ignored by Git; never commit real credentials.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/project2
DOCUMENT_DIRECTORY=/data/documents

# Database and processing limits (defaults from src/config/limits.py)
DATABASE_POOL_SIZE=4
PROVIDER_TIMEOUT=120
JOB_LEASE_SECONDS=60
CHUNK_BYTES=16000
MAX_CHUNKS=32

# AI provider configuration. GPT_* values take precedence over OPENAI_* aliases.
GPT_API_KEY=
GPT_BASE_URL=https://api.openai.com/v1
GPT_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Worker concurrency is bounded by the settings validator (1-8).
GPT_CONCURRENCY=2
DOCUMENT_WORKERS=3
DOCLING_URL=http://docling:5001
